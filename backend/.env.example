# Example environment variables for Job Application Co-Pilot
# Copy to `.env` and update values before running locally

# Database (default: SQLite file in project root)
DATABASE_URL=sqlite:///./job_copilot.db

# JWT secret used for token generation (replace in production)
SECRET_KEY=change_me_to_a_strong_secret

# Groq API key (if using Groq LLM integration)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=800
GROQ_MAX_RETRIES=2
GROQ_API_KEY="Your actual GROQ API credential string here"